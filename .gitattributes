# Unity YAML: merge as text, never convert line endings in a way Unity dislikes
*.unity     text eol=lf
*.prefab    text eol=lf
*.asset     text eol=lf
*.mat       text eol=lf
*.meta      text eol=lf
*.asmdef    text eol=lf
*.cs        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.py        text eol=lf

# Binary assets (consider Git LFS for these if the repo grows: `git lfs track "*.fbx" "*.blend" "*.glb"`)
*.fbx   binary
*.blend binary
*.glb   binary
*.png   binary
*.jpg   binary
*.exr   binary
*.wav   binary
